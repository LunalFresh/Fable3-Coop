{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Title",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceRoot}/bin/${input:buildPlatform}/${input:buildConfig}/xlln-test.exe",
			"args": [
				"-xllndebug",
				"-xllndebuglog",
			],
			"stopAtEntry": false,
			"cwd": "${workspaceRoot}/bin/",
			"environment": [],
			"externalConsole": false,
			"windows": {
				"MIMode": "gdb",
				// Install https://www.msys2.org/
				// Then run the following in a (purple coloured) MSYS2 MSYS terminal: `pacman -S --needed base-devel mingw-w64-ucrt-x86_64-toolchain`
				"miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
			},
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true,
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true,
				},
			],
		},
		{
			"name": "Python Debugger: generate-headers.py",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceRoot}/.tools/generate-headers.py",
			"cwd": "${workspaceRoot}/.tools/",
			"console": "integratedTerminal",
		},
	],
	"inputs": [
		{
			"type": "pickString",
			"id": "buildPlatform",
			"description": "Select build platform:",
			"default": "Win32",
			"options": ["Win32", "x64"],
		},
		{
			"type": "pickString",
			"id": "buildConfig",
			"description": "Select build configuration:",
			"default": "Debug",
			"options": ["Debug", "Release"],
		},
	],
}